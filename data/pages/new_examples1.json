{
  "title": "Text, lists and emphasis",
  "description": "Every prose element shown normal, in the left column and in the right column.",
  "add_content_to_page": [
    {
      "add_paragraph": {
        "text": "Every element is shown three ways: **Normal** (no `column`), **Left column** (`column: \"left\"`) and **Right column** (`column: \"right\"`). The left and right copies share a row; the normal copy uses the full width.",
        "is_lead": true
      }
    },
    {
      "add_special_note": {
        "colour": "info",
        "heading": "One rule",
        "text": "No column, full width. A column value puts the element in that lane. Nothing else is needed."
      }
    },
    {
      "add_heading": {
        "level": 3,
        "heading_text": "Paragraphs"
      }
    },
    {
      "add_paragraph": {
        "text": "`add_paragraph` takes `text`, an optional `heading`, `is_lead`, `layout: \"two-col\"` and `column`. Inline markup works: **bold**, *italic*, `code`, [links](https://example.com)."
      }
    },
    {
      "add_heading": {
        "level": 4,
        "heading_text": "Normal"
      }
    },
    {
      "add_paragraph": {
        "text": "A paragraph with **bold**, *italic*, `code` and a [link](https://example.com). No column means the full width; a left or right column puts it in that lane."
      }
    },
    {
      "add_heading": {
        "level": 4,
        "heading_text": "Left column",
        "column": "left"
      }
    },
    {
      "add_paragraph": {
        "text": "A paragraph with **bold**, *italic*, `code` and a [link](https://example.com). No column means the full width; a left or right column puts it in that lane.",
        "column": "left"
      }
    },
    {
      "add_heading": {
        "level": 4,
        "heading_text": "Right column",
        "column": "right"
      }
    },
    {
      "add_paragraph": {
