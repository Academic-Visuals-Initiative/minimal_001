    {
      "add_heading": {
        "level": 3,
        "heading_text": "Headings"
      }
    },
    {
      "add_paragraph": {
        "text": "`add_heading` takes `heading_text`, `level` 1–4, an optional `subheading` and `column`."
      }
    },
    {
      "add_heading": {
        "level": 4,
        "heading_text": "Normal"
      }
    },
    {
      "add_heading": {
        "level": 3,
        "heading_text": "A heading",
        "subheading": "Optional subheading"
      }
    },
    {
      "add_heading": {
        "level": 4,
        "heading_text": "Left column",
        "column": "left"
      }
    },
    {
      "add_heading": {
        "level": 3,
        "heading_text": "A heading",
        "subheading": "Optional subheading",
