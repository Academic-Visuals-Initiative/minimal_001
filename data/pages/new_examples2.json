{
  "title": "Images, galleries and slideshows",
  "description": "Media elements shown normal, in the left column and in the right column.",
  "add_content_to_page": [
    {
      "add_paragraph": {
        "text": "Every element is shown three ways: **Normal** (no `column`), **Left column** (`column: \"left\"`) and **Right column** (`column: \"right\"`). The left and right copies share a row; the normal copy uses the full width.",
        "is_lead": true
      }
    },
    {
      "add_special_note": {
        "colour": "info",
        "heading": "One rule",
        "text": "No column, full width. A column value puts the element in that lane. Nothing else is needed."
      }
    },
    {
      "add_heading": {
        "level": 3,
        "heading_text": "Images"
      }
    },
    {
      "add_paragraph": {
        "text": "`add_image` takes `image_path`, `image_alt`, `image_caption`, `image_credit`, `align`, `zoom_on` and `column`. A bare filename reads from `assets/images/`."
      }
    },
    {
      "add_heading": {
        "level": 4,
        "heading_text": "Normal"
      }
    },
    {
      "add_image": {
        "image_path": "assets/img/ph-01.jpg",
